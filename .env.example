# KI-Dokumenten-Archiv – Umgebungsvariablen
# Kopiere diese Datei nach .env und fülle alle Werte aus.
# Die .env-Datei wird von docker-compose automatisch geladen.
# WICHTIG: .env darf NICHT in Git committed werden!

# ---------------------------------------------------------------------------
# Datenbankpasswörter (PFLICHTFELDER)
# ---------------------------------------------------------------------------
DB_ROOT_PASSWORD=changeme_root_password
DB_PASSWORD=changeme_archive_password
DB_NAME=document_archive
DB_USER=archive_user

# ---------------------------------------------------------------------------
# Paperless-ngx API-Token
# In Paperless: Admin → Token erstellen
# ---------------------------------------------------------------------------
PAPERLESS_API_TOKEN=your_paperless_api_token_here

# ---------------------------------------------------------------------------
# GPU-IDs (0 = erste GPU, 1 = zweite GPU)
# ---------------------------------------------------------------------------
VISION_GPU_ID=0
EMBEDDING_GPU_ID=1

# ---------------------------------------------------------------------------
# Verzeichnisse (Host-Pfade)
# ---------------------------------------------------------------------------
SCAN_INPUT_DIR=/data/scans
SPLIT_OUTPUT_DIR=/data/split
ANALYZED_OUTPUT_DIR=/data/analyzed
QUARANTINE_DIR=/data/quarantine
DB_DATA_DIR=/data/mariadb
TMP_DIR=/data/tmp
LOG_DIR=/data/logs

# ---------------------------------------------------------------------------
# RAG-Chat Port
# ---------------------------------------------------------------------------
RAG_CHAT_PORT=8080

# ---------------------------------------------------------------------------
# Pre-Classifier (Voranalyse – Profil: preclass)
# ---------------------------------------------------------------------------
# LLM-Backend: ollama (lokal) oder openai
PRE_CLASSIFIER_BACKEND=ollama
# Ollama: Modell-Verzeichnis (Modelle werden hier gespeichert, ~4–30 GB)
OLLAMA_DATA_DIR=/data/ollama
# OpenAI API-Key (nur wenn PRE_CLASSIFIER_BACKEND=openai)
OPENAI_API_KEY=
# Ausgabeverzeichnis für Voranalyse-Berichte (JSON-Listen)
PRE_ANALYSIS_DIR=/data/pre_analysis

# ---------------------------------------------------------------------------
# Regeln-Cache TTL (Sekunden bis Regeln/Prompts aus DB neu geladen werden)
# ---------------------------------------------------------------------------
RULES_CACHE_TTL=60

